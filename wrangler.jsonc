{
  "name": "amo-schedule-app",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // Custom domain: created automatically on deploy (andrewmurphy.online is a zone in this account).
  "routes": [{ "pattern": "mikes.andrewmurphy.online", "custom_domain": true }],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "mikes-schedule-db", "database_id": "c9c1e842-b5b7-4db2-97a5-907080a4715a" }
  ]
}
